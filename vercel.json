{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/m",
      "destination": "/menu.html"
    },
    {
      "source": "/carte",
      "destination": "/carte.html"
    },
    {
      "source": "/groupes",
      "destination": "/groupes.html"
    },
    {
      "source": "/brochettes",
      "destination": "/soirees-brochettes.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/coucher-de-soleil",
      "destination": "/coucher-de-soleil.html"
    },
    {
      "source": "/restaurant-vue-mer-sete",
      "destination": "/restaurant-vue-mer-sete.html"
    },
    {
      "source": "/mont-saint-clair",
      "destination": "/manger-mont-saint-clair.html"
    }
  ],
  "redirects": [
    {
      "source": "/menu",
      "destination": "/m",
      "permanent": true
    }
  ]
}
